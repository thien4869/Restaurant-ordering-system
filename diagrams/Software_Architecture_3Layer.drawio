        <mxCell id="e3" value="Uses admin functions" style="endArrow=open;endFill=0;html=0;strokeColor=#5F6B7A;fontSize=8;labelBackgroundColor=none;verticalAlign=bottom;align=left;" edge="1" parent="1" source="admin" target="adminDash">
