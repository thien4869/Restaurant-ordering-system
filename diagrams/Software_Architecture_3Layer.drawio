<mxfile host="app.diagrams.net">
  <diagram id="arch3layer" name="3-Layer Architecture">
    <mxGraphModel dx="1290" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Titles -->
        <mxCell id="title1" value="SOFTWARE ARCHITECTURE – 3-LAYER ARCHITECTURE" style="text;html=0;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#1F3A5F;" vertex="1" parent="1">
          <mxGeometry x="244" y="25" width="800" height="24" as="geometry" />
        </mxCell>
        <mxCell id="title2" value="RESTAURANT ORDERING MANAGEMENT SYSTEM | GROUP 11" style="text;html=0;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#1F3A5F;" vertex="1" parent="1">
          <mxGeometry x="244" y="49" width="800" height="22" as="geometry" />
        </mxCell>

        <!-- Container boxes (drawn first so they sit behind) -->
        <mxCell id="boxUsers" value="USERS / ACTORS" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#F1F5FA;strokeColor=#9DB2CF;fontSize=12;fontColor=#1F3A5F;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="80" width="687" height="76" as="geometry" />
        </mxCell>
        <mxCell id="boxL1" value="LAYER 1 – PRESENTATION LAYER (USER INTERFACE)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E8F1FA;strokeColor=#2878B5;strokeWidth=1.5;fontSize=11;fontColor=#1F3A5F;verticalAlign=top;spacingTop=14;" vertex="1" parent="1">
          <mxGeometry x="38" y="161" width="1211" height="108" as="geometry" />
        </mxCell>
        <mxCell id="boxL2" value="LAYER 2 – BUSINESS LOGIC LAYER (APPLICATION SERVICES)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E9F5EB;strokeColor=#3A7D44;strokeWidth=1.5;fontSize=11;fontColor=#1F3A5F;verticalAlign=top;spacingTop=14;" vertex="1" parent="1">
          <mxGeometry x="24" y="275" width="1239" height="114" as="geometry" />
        </mxCell>
        <mxCell id="boxL3" value="LAYER 3 – DATA ACCESS LAYER (REPOSITORIES)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FDF1E0;strokeColor=#B8770B;strokeWidth=1.5;fontSize=11;fontColor=#1F3A5F;verticalAlign=top;spacingTop=14;" vertex="1" parent="1">
          <mxGeometry x="74" y="395" width="1034" height="107" as="geometry" />
