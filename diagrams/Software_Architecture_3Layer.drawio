        <mxCell id="custWeb" value="Customer Web / App&#xa;Menu • Cart • Order History&#xa;View Details • Cancel Order • Place Order" style="ellipse;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#1F4E79;strokeWidth=1.5;fontSize=9;fontColor=#14274E;" vertex="1" parent="1">
