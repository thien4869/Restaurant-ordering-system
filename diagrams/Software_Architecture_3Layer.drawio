        <!-- Edges: actors -> presentation -->
        <mxCell id="e1" value="Uses customer functions" style="endArrow=open;endFill=0;html=0;strokeColor=#5F6B7A;fontSize=8;labelBackgroundColor=none;verticalAlign=bottom;align=left;" edge="1" parent="1" source="guest" target="custWeb">
